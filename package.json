{
  "name": "mina",
  "version": "0.1.0",
  "private": true,
  "description": "Research and engineering harness for the Pi coding agent: long goals proved by checks, background compaction and handoff, scholarly and web research, a sandbox for each command, and no telemetry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mratan/mina.git"
  },
  "homepage": "https://github.com/mratan/mina#readme",
  "type": "module",
  "bin": {
    "mina": "bin/mina.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@narumitw/pi-goal": "0.54.8",
    "@tintinweb/pi-subagents": "0.19.0",
    "pi-hot-compact": "0.3.0",
    "pi-claude-subscription": "file:vendor/pi-claude-subscription-0.2.4-mina.5.tgz"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 'test/**/*.test.mjs' 'adapters/pi-research-search/test/**/*.test.mjs' 'literature/test/**/*.test.mjs'",
    "test:mina": "node --test 'test/**/*.test.mjs'",
    "literature:install": "bash scripts/literature-install.sh",
    "literature:runtime": "bash scripts/literature-runtime.sh",
    "literature:smoke": "node literature/smoke.mjs",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=1200000 test/e2e/privacy.e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@google/genai": false,
    "protobufjs": false
  },
  "overrides": {
    "undici": "8.12.3"
  }
}
